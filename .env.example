# Copiá a .env para probar local (nunca subas este archivo con valores reales a git).
# En producción se cargan en Vercel → Project Settings → Environment Variables.

# --- Stripe ---
# Dashboard de Stripe → Developers → API keys. Usá la de TEST (sk_test_...)
# hasta haber probado un pedido completo; recién ahí pasás a la de LIVE (sk_live_...).
STRIPE_SECRET_KEY=

# Dashboard → Developers → Webhooks → tu endpoint → "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Prodigi ---
# sandbox mientras probás (no imprime ni cobra nada real), live cuando ya
# confirmaste que un pedido de prueba salió bien.
PRODIGI_ENV=sandbox
# Dashboard de Prodigi → Settings → Integrations → API → "Show API Key"
PRODIGI_API_KEY=

# --- data.json canónico (para recalcular precios del lado del servidor) ---
GITHUB_OWNER=Azerian126
GITHUB_REPO=Cantbelievetheview
GITHUB_BRANCH=main

# --- CORS ---
CORS_ORIGIN=https://cantbelievetheview.com

# --- Cloudinary (para subir la tarjeta A6 que se genera por cada pedido de
# impresión) — misma cuenta que ya usa el bot de Telegram ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (numeración real de ediciones — cuántas veces se vendió cada
# foto en impresión). Podés reusar la MISMA base de Upstash que ya
# conectaste al bot (Vercel → proyecto del bot → Storage → esas mismas
# credenciales), o conectar una nueva acá — cualquiera de las dos sirve. ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
